{
  "name": "@wenbin_wb/dsh-bridge",
  "version": "2.17.7",
  "description": "DSH 远程连接/远程控制插件（remote control）：手机扫码即可在移动端/公网继续用 DeepSeek Harness，人不在电脑前也能接着干。一键局域网二维码、Cloudflare 公网隧道、自建隧道与微信 / QQ / 飞书 / Telegram Bot（多工作区/会话持久化/媒体/卡片审批/流式输出），无需自己搭公网服务器。",
  "releaseNotes": "【v2.17.7】\n• 修正：上一版发布时漏同步更新说明，本版补回（功能变更见下）\n• 新增 IM 指令 /model：列出并切换模型（/model 列表、/model 2 选择、reset 恢复默认）\n• 修复 /new 之后审批卡片不出现、审批落到电脑端弹窗\n• 修复「实时活动状态」勾选后回显恒为关闭\n• 修复经隧道/局域网访问时部分请求被 403\n• 加固 loopback 会话鉴权，并补充诊断日志",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build:client": "node client/build.mjs",
    "build:lark": "node scripts/bundle-lark.mjs",
    "build:qq": "node scripts/bundle-qq.mjs",
    "build:banner": "node scripts/generate-banner.mjs",
    "prepack": "npm run build:client && npm run build:qq",
    "release:github": "node scripts/create-github-release.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "verify:mobile-ui": "node test/browser/run-all.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@eslint/js": "^10.0.1",
    "@larksuite/channel": "^0.7.1",
    "@larksuiteoapi/node-sdk": "^1.75.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "espree": "^11.2.0",
    "follow-redirects": "^1.16.1",
    "globals": "^17.11.0",
    "puppeteer-core": "^25.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "remote-access",
    "tunnel",
    "cloudflare",
    "mobile",
    "smartphone",
    "tablet",
    "qr-code",
    "qrcode",
    "websocket",
    "bot",
    "wechat",
    "qq",
    "feishu",
    "telegram",
    "remote-control",
    "remote-development",
    "remote-ui",
    "mobile-access",
    "dsh-remote",
    "dsh-bridge",
    "dsh-mobile",
    "dsh-remote-control",
    "dsh-remote-access",
    "mobile-remote",
    "mobile-control",
    "phone-remote",
    "pwa",
    "android",
    "ios",
    "public-tunnel",
    "lan-access",
    "远程连接",
    "远程控制",
    "远程访问",
    "移动端",
    "dsh移动端",
    "手机远程"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenbin-wb/dsh-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/wenbin-wb/dsh-bridge/issues"
  },
  "homepage": "https://github.com/wenbin-wb/dsh-bridge",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "optionalDependencies": {
    "@tencent-connect/qqbot-connector": "^1.2.0"
  }
}
