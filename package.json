{
  "name": "@wenbin_wb/dsh-bridge",
  "version": "2.12.3",
  "description": "DSH 远程连接/远程控制插件（remote control）：手机扫码即可在移动端/公网继续用 DeepSeek Harness，人不在电脑前也能接着干。一键局域网二维码、Cloudflare 公网隧道、自建隧道与微信 / QQ / 飞书 / Telegram Bot（多工作区/会话持久化/媒体/卡片审批/流式输出），无需自己搭公网服务器。",
  "releaseNotes": "【v2.12.3】安全加固与暗色主题可读性修复：收紧回环令牌的跨域授权、令牌响应禁止缓存、隧道地址凭据仅管理员可见；修复桌面版 IM 平台加载与暗色主题多处文字/按钮看不清；升级 ws、globals。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build:client": "node client/build.mjs",
    "build:lark": "node scripts/bundle-lark.mjs",
    "build:banner": "node scripts/generate-banner.mjs",
    "prepack": "npm run build:client",
    "release:github": "node scripts/create-github-release.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "verify:mobile-ui": "node test/browser/run-all.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@eslint/js": "^10.0.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "puppeteer-core": "^25.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "remote-access",
    "tunnel",
    "cloudflare",
    "mobile",
    "smartphone",
    "tablet",
    "qr-code",
    "qrcode",
    "websocket",
    "bot",
    "wechat",
    "qq",
    "feishu",
    "telegram",
    "remote-control",
    "remote-development",
    "remote-ui",
    "mobile-access",
    "dsh-remote",
    "dsh-bridge",
    "dsh-mobile",
    "dsh-remote-control",
    "dsh-remote-access",
    "mobile-remote",
    "mobile-control",
    "phone-remote",
    "pwa",
    "android",
    "ios",
    "public-tunnel",
    "lan-access",
    "远程连接",
    "远程控制",
    "远程访问",
    "移动端",
    "dsh移动端",
    "手机远程"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenbin-wb/dsh-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/wenbin-wb/dsh-bridge/issues"
  },
  "homepage": "https://github.com/wenbin-wb/dsh-bridge",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
