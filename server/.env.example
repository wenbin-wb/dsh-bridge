# DSH Remote Server 环境变量配置

# 服务器端口
PORT=8080

# 允许的访问令牌 (逗号分隔,支持多个)
# 使用 `dsh-remote generate-token` 生成
ALLOWED_TOKENS=your-token-1,your-token-2,your-token-3

# 可选: 日志级别
# LOG_LEVEL=info

# 可选: 最大连接数
# MAX_CONNECTIONS=100

# 可选: WebSocket 心跳间隔 (秒)
# WS_HEARTBEAT_INTERVAL=30

# 可选: 请求超时 (毫秒)
# REQUEST_TIMEOUT=30000
